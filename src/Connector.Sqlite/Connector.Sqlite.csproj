<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>db-sqlite</AssemblyName>
    <RootNamespace>Connector.Sqlite</RootNamespace>
    <PublishAot>true</PublishAot>

    <!-- 版本资源：缺少版本信息/清单的原生 exe 更容易被安全软件误判 -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>local-skill-tools</Product>
    <AssemblyTitle>SQLite connector</AssemblyTitle>
    <Description>SQLite 查询 / 执行工具（NativeAOT）</Description>
    <Company>local-skill-tools</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Connector.Core\Connector.Core.csproj" />
  </ItemGroup>

</Project>
