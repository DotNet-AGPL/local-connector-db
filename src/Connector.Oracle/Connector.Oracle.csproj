<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>db-oracle</AssemblyName>
    <RootNamespace>Connector.Oracle</RootNamespace>
    <PublishAot>true</PublishAot>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>local-skill-tools</Product>
    <AssemblyTitle>Oracle connector</AssemblyTitle>
    <Description>Oracle 查询 / 执行工具（NativeAOT）</Description>
    <Company>local-skill-tools</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- ODP.NET 的连接/网络栈依赖反射，裁剪后会出现 ORA-50201，必须整根保留 -->
    <TrimmerRootAssembly Include="Oracle.ManagedDataAccess" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Connector.Core\Connector.Core.csproj" />
  </ItemGroup>

</Project>
