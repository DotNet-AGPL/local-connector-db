<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>net-ssh</AssemblyName>
    <RootNamespace>Net.Ssh</RootNamespace>
    <PublishAot>true</PublishAot>

    <!-- 版本资源：缺少版本信息/清单的原生 exe 更容易被安全软件误判 -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>local-skill-tools</Product>
    <AssemblyTitle>SSH connector</AssemblyTitle>
    <Description>远程执行命令（NativeAOT）</Description>
    <Company>local-skill-tools</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Net.Core\Net.Core.csproj" />
  </ItemGroup>

</Project>
